cmake_minimum_required(VERSION 3.21)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED MX_QT_ROOT)
    set(MX_QT_ROOT "$ENV{MX_QT_ROOT}")
endif()
if(NOT DEFINED MX_QWT_ROOT)
    set(MX_QWT_ROOT "$ENV{MX_QWT_ROOT}")
endif()
if(NOT MX_QWT_ROOT)
    set(MX_QWT_ROOT "${repo}/.local/qwt-sdk")
endif()
file(TO_CMAKE_PATH "${MX_QWT_ROOT}" prefix)
get_filename_component(prefix "${prefix}" ABSOLUTE)
set(qmake "${MX_QT_ROOT}/bin/qmake.exe")
if(NOT EXISTS "${qmake}")
    message(FATAL_ERROR "Set MX_QT_ROOT to Qt 5.15 MSVC x64.")
endif()
find_program(nmake NAMES nmake REQUIRED)

# SourceForge's original tarball; independently verified against the Arch package digest.
set(url "https://downloads.sourceforge.net/project/qwt/qwt/6.2.0/qwt-6.2.0.tar.bz2")
set(hash "9194f6513955d0fd7300f67158175064460197abab1a92fa127a67a4b0b71530")
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(deps "${repo}/.local/dependencies")
set(extract "${deps}/qwt-source-${run_id}")
set(build "${deps}/qwt-build-${run_id}")
if(NOT MX_QWT_ARCHIVE)
    set(download "${deps}/qwt-download-${run_id}")
    file(MAKE_DIRECTORY "${download}")
    set(MX_QWT_ARCHIVE "${download}/qwt-6.2.0.tar.bz2")
    find_program(curl NAMES curl.exe curl REQUIRED)
    execute_process(COMMAND "${curl}" --proto =https --fail --location --retry 2 --max-time 180
        "${url}" -o "${MX_QWT_ARCHIVE}" COMMAND_ERROR_IS_FATAL ANY)
endif()
file(SHA256 "${MX_QWT_ARCHIVE}" actual_hash)
if(NOT actual_hash STREQUAL hash)
    message(FATAL_ERROR "Qwt archive checksum mismatch: ${MX_QWT_ARCHIVE}")
endif()
file(MAKE_DIRECTORY "${extract}" "${build}")
file(ARCHIVE_EXTRACT INPUT "${MX_QWT_ARCHIVE}" DESTINATION "${extract}")
set(source "${extract}/qwt-6.2.0")

# The shadow build compiles only the library. Do not modify the extracted sources or system Qt.
execute_process(COMMAND "${qmake}" "${source}/src/src.pro" -after
    "CONFIG-=debug debug_and_release build_all" "CONFIG+=release"
    "QWT_CONFIG-=QwtDesigner QwtDesignerSelfContained QwtExamples QwtPlayground QwtTests"
    "headers.path=${prefix}/include" "target.path=${prefix}/lib"
    WORKING_DIRECTORY "${build}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${nmake}" /nologo WORKING_DIRECTORY "${build}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${nmake}" /nologo install WORKING_DIRECTORY "${build}" COMMAND_ERROR_IS_FATAL ANY)
if(NOT EXISTS "${prefix}/lib/qwt.lib" OR NOT EXISTS "${prefix}/lib/qwt.dll")
    message(FATAL_ERROR "Qwt Release import library or DLL was not installed to ${prefix}/lib.")
endif()
file(COPY_FILE "${source}/COPYING" "${prefix}/Qwt-COPYING.txt" ONLY_IF_DIFFERENT)
message(STATUS "Qwt 6.2.0 SDK: ${prefix}")
