		set_target_properties(OpenCASCADE::${occlib} PROPERTIES
			IMPORTED_LOCATION_RELEASE "/usr/local/lib/lib${occlib}.so"
			IMPORTED_LOCATION_DEBUG "/usr/local/lib/lib${occlib}d.so"
			LINK_FLAGS "-Wl,-rpath,/usr/local/lib/"
		)
	elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
		set_property(TARGET OpenCASCADE::${occlib} APPEND PROPERTY IMPORTED_CONFIGURATIONS DEBUG)
		set_target_properties(OpenCASCADE::${occlib} PROPERTIES
			IMPORTED_LOCATION_RELEASE "${OpenCASCADE_BINARY_DIRS}/${occlib}.dll"
			IMPORTED_LOCATION_DEBUG "${OpenCASCADE_BINARY_DIRS}d/${occlib}.dll"
		)
	endif()
endforeach()

