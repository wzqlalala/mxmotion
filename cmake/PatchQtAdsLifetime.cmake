# ADS 4.4.1's Linux focusWindowChanged lambda captures CDockManager without
# a QObject context. QApplication therefore calls a dangling manager after a
# document/main window is destroyed (e.g. when the next popup takes focus).
# Compile a corrected copy; never change a user-supplied ADS source checkout.
function(mx_patch_qtads_lifetime target)
    get_target_property(ads_directory "${target}" SOURCE_DIR)
    get_target_property(ads_sources "${target}" SOURCES)
    set(original "${ads_directory}/DockManager.cpp")
    if(NOT EXISTS "${original}")
        message(FATAL_ERROR "Cannot locate ADS DockManager.cpp for the Linux lifetime fix")
    endif()
    file(READ "${original}" content)
    set(before "connect(qApp, &QApplication::focusWindowChanged, [this](QWindow* focusWindow)")
    set(after "connect(qApp, &QApplication::focusWindowChanged, this, [this](QWindow* focusWindow)")
    string(FIND "${content}" "${before}" unsafe)
    string(FIND "${content}" "${after}" safe)
    if(unsafe EQUAL -1 AND safe EQUAL -1)
        message(FATAL_ERROR "ADS focus connection differs from the pinned/reviewed forms; review its QObject lifetime before updating ADS")
    endif()
    string(REPLACE "${before}" "${after}" patched "${content}")
    set(copy "${CMAKE_BINARY_DIR}/mx-qtads-patched/DockManager.cpp")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/mx-qtads-patched")
    file(CONFIGURE OUTPUT "${copy}" CONTENT "${patched}" @ONLY)
    set(replacements 0)
    set(revised)
    foreach(source IN LISTS ads_sources)
        if(source MATCHES "^\\$<")
            list(APPEND revised "${source}")
            continue()
        endif()
        if(IS_ABSOLUTE "${source}")
            set(absolute "${source}")
        else()
            set(absolute "${ads_directory}/${source}")
        endif()
        if(absolute STREQUAL original)
            list(APPEND revised "${copy}")
            math(EXPR replacements "${replacements} + 1")
        else()
            list(APPEND revised "${absolute}")
        endif()
    endforeach()
    if(NOT replacements EQUAL 1)
        message(FATAL_ERROR "Expected exactly one ADS DockManager.cpp translation unit")
    endif()
    set_property(TARGET "${target}" PROPERTY SOURCES "${revised}")
endfunction()
